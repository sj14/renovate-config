{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared preset without automerge, for repositories without CI",
  "extends": ["local>sj14/renovate-config"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": false
  }
}
